@inherits LayoutComponentBase
@using NewsSMKN6Malang.Data
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject NavigationManager Navigation
@inject NewsService NewsService

<div class="flex h-screen bg-gray-50 font-sans overflow-hidden relative">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-100 flex flex-col hidden md:flex z-20">
        <div class="p-6 flex items-center gap-3">
             <!-- Brand -->
            <img src="/logo.png" class="w-8 h-8 object-contain" alt="SMKN 6 Malang Logo" />
            <span class="text-xl font-heading font-bold text-gray-800">SMKN 6</span>
        </div>

        <nav class="flex-1 px-4 py-2 space-y-1 overflow-y-auto">
            <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 mt-4 px-2">Menu Utama</div>
            <NavLink href="/" Match="NavLinkMatch.All" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-blue-50 hover:text-primary transition-all group">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span class="font-medium">Beranda</span>
            </NavLink>
            <NavLink href="/news" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-blue-50 hover:text-primary transition-all group">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                <span class="font-medium">Berita Terkini</span>
            </NavLink>

            <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2 mt-8 px-2">Kategori</div>
            
            @if (categoryCounts != null && categoryCounts.Any())
            {
                var colors = new[] { "bg-blue-500", "bg-yellow-500", "bg-green-500", "bg-red-500", "bg-purple-500" };
                int colorIndex = 0;

                @foreach (var cat in categoryCounts)
                {
                    <a href="/news?category=@Uri.EscapeDataString(cat.Key)" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-blue-50 hover:text-primary transition-all justify-between">
                        <div class="flex items-center gap-3">
                            <span class="w-2 h-2 rounded-full @(colors[colorIndex % colors.Length])"></span>
                            <span class="font-medium text-sm">@cat.Key</span>
                        </div>
                        <span class="text-[10px] font-bold bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">@cat.Value</span>
                    </a>
                    colorIndex++;
                }
            }
            else
            {
                <div class="px-3 py-2.5 text-xs text-gray-400">Memuat kategori...</div>
            }
        </nav>

        <div class="p-4 border-t border-gray-100">
            <div class="bg-blue-50 rounded-xl p-4 relative overflow-hidden group">
                <div class="relative z-10">
                    <h5 class="text-sm font-bold text-primary mb-1">PPDB 2026</h5>
                    <p class="text-xs text-blue-600/80 mb-3">Pendaftaran segera dibuka.</p>
                    <a href="https://test.smkn6malang.sch.id/pendaftaran" target="_blank" class="inline-block text-xs bg-primary text-white px-3 py-1.5 rounded-md hover:shadow-lg hover:-translate-y-0.5 transition-all">Info Detail</a>
                </div>
                <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-blue-200/50 rounded-full group-hover:scale-110 transition-transform"></div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden relative">
        <!-- Header -->
        <header class="h-16 bg-white border-b border-gray-100 flex items-center justify-between px-6 z-10 relative">
            <div class="flex items-center gap-4 flex-1">
                <button class="md:hidden text-gray-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
                <div class="relative w-full max-w-sm hidden md:block">
                    <input type="text" @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" placeholder="Cari berita... (Tekan Enter)" class="w-full pl-10 pr-4 py-2 bg-gray-50 border-none rounded-lg text-sm focus:ring-2 focus:ring-primary/20 focus:bg-white transition-all outline-none text-gray-600 placeholder-gray-400">
                    <svg class="absolute left-3 top-2.5 text-gray-400 w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <div class="relative">
                    <button @onclick="ToggleNotifications" class="text-gray-400 hover:text-primary transition-colors relative block p-1">
                        @if (recentNews != null && recentNews.Any(n => (DateTime.UtcNow - n.CreatedAt).TotalDays < 3))
                        {
                            <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full border-2 border-white animate-pulse"></span>
                        }
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    </button>

                    <!-- Notifications Dropdown Panel -->
                    @if (showNotifications)
                    {
                        <div class="absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-2xl border border-gray-100 overflow-hidden z-50 animate-in fade-in duration-200">
                            <div class="px-4 py-3 bg-gray-50 border-b border-gray-100 flex justify-between items-center">
                                <span class="text-xs font-bold text-gray-800 uppercase tracking-wide">Notifikasi Terbaru</span>
                                <span class="text-[10px] bg-primary text-white rounded-full px-2 py-0.5">Hari Ini</span>
                            </div>
                            <div class="max-h-[300px] overflow-y-auto">
                                @if (recentNews == null || !recentNews.Any())
                                {
                                    <div class="p-6 text-center text-xs text-gray-400">Belum ada pembaruan aktivitas.</div>
                                }
                                else
                                {
                                    @foreach (var n in recentNews)
                                    {
                                        <a href="/news/@n.Id" @onclick="() => showNotifications = false" class="block p-4 border-b border-gray-50 hover:bg-blue-50 transition-colors">
                                            <p class="text-xs font-bold text-gray-800 mb-1 leading-snug">@n.Title</p>
                                            <div class="flex items-center gap-2">
                                                <span class="text-[10px] text-primary font-semibold">@n.DisplayCategory</span>
                                                <span class="text-[10px] text-gray-400">@n.DisplayDate.ToString("dd MMM HH:mm")</span>
                                            </div>
                                        </a>
                                    }
                                }
                            </div>
                            <div class="p-2 text-center bg-gray-50 border-t border-gray-100">
                                <a href="/news" @onclick="() => showNotifications = false" class="text-xs text-primary font-bold hover:underline">Lihat Semua Berita</a>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Admin Popup Toggle Button -->
                <button @onclick="ToggleAdminModal" title="Admin Panel" class="h-8 w-8 rounded-lg bg-blue-600 overflow-hidden border border-blue-700 flex items-center justify-center shadow-sm hover:scale-105 transition-transform text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </button>
            </div>
        </header>

        <!-- Scrollable Area -->
        <main class="flex-1 overflow-y-auto bg-gray-50 p-6">
            @Body
        </main>
    </div>

    @if (showAdminModal)
    {
        <!-- Full-Screen Modal for Payload CMS -->
        <!-- Omitted unchanged code for brevity... -->
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/60 backdrop-blur-sm p-4 md:p-8 animate-in fade-in duration-200">
            <div class="bg-white rounded-xl shadow-2xl w-full h-full max-w-7xl flex flex-col overflow-hidden relative border border-gray-200">
                <div class="h-14 bg-gray-50 border-b border-gray-100 flex items-center justify-between px-4 flex-shrink-0">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-blue-600 rounded-md flex items-center justify-center">
                            <span class="text-white font-bold text-xs uppercase">AP</span>
                        </div>
                        <h2 class="font-bold text-gray-800 text-sm">Admin Panel</h2>
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <button @onclick="ToggleAdminModal" class="p-2 text-gray-400 hover:text-red-500 hover:bg-gray-100 rounded-lg transition-colors flex items-center gap-2">
                            <span class="text-xs font-semibold">Tutup</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Iframe Embed -->
                <div class="flex-1 bg-white relative">
                    <iframe src="@EndpointUrl" class="absolute inset-0 w-full h-full border-0"></iframe>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool showAdminModal = false;
    private bool showNotifications = false;
    private string EndpointUrl => $"{Configuration["ApiSettings:BaseUrl"] ?? "https://test.smkn6malang.sch.id"}/admin/collections/news";
    
    private string searchQuery = "";
    private Dictionary<string, int>? categoryCounts;
    private List<NewsItem>? recentNews;

    protected override async Task OnInitializedAsync()
    {
        var allNews = await NewsService.GetNewsAsync();
        categoryCounts = allNews
            .GroupBy(n => n.CategoryRaw)
            .ToDictionary(g => g.Key, g => g.Count());
            
        recentNews = allNews.OrderByDescending(n => n.CreatedAt).Take(5).ToList();
    }

    private void ToggleAdminModal()
    {
        showAdminModal = !showAdminModal;
        showNotifications = false;
    }
    
    private void ToggleNotifications()
    {
        showNotifications = !showNotifications;
    }

    private void HandleSearch(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            showNotifications = false;
            Navigation.NavigateTo($"/news?q={Uri.EscapeDataString(searchQuery)}");
        }
    }
}