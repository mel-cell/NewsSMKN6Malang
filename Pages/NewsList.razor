@page "/news"
@using NewsSMKN6Malang.Data
@inject NewsService NewsService
@inject NavigationManager Navigation

<div class="max-w-7xl mx-auto space-y-8 pb-10 mt-6">
    <div class="mb-8">
        <h1 class="text-3xl font-heading font-bold text-gray-800 mb-2">
            @(string.IsNullOrWhiteSpace(Category) ? "Berita Terkini" : $"Kategori: {Category}")
        </h1>
        <p class="text-gray-500">
            @(string.IsNullOrWhiteSpace(Q) ? "Dapatkan informasi, pengumuman, dan berita terbaru dari kawasan lingkungan sekolah." : $"Hasil pencarian untuk '{Q}'")
        </p>
    </div>

    @if (newsList == null)
    {
        <div class="flex items-center justify-center py-20">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-primary"></div>
        </div>
    }
    else if (!newsList.Any())
    {
        <div class="text-center py-20 bg-white rounded-2xl shadow-sm border border-gray-100">
            <p class="text-gray-500 text-lg">Belum ada berita yang sesuai dengan kriteria.</p>
            @if (!string.IsNullOrWhiteSpace(Q) || !string.IsNullOrWhiteSpace(Category))
            {
                <a href="/news" class="mt-4 inline-block text-primary font-bold hover:underline">Tampilkan semua berita</a>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            @foreach (var item in newsList)
            {
                <a href="/news/@item.Id" class="group flex flex-col bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden h-full">
                    <div class="relative h-48 md:h-56 overflow-hidden">
                        <img src="@item.DisplayImageUrl" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt="@item.Title" />
                        <div class="absolute top-4 left-4">
                            <span class="bg-white/90 backdrop-blur-sm text-primary text-xs font-bold px-3 py-1.5 rounded shadow-sm">@item.DisplayCategory</span>
                        </div>
                    </div>
                    
                    <div class="p-6 flex-1 flex flex-col">
                        <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-3">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            @item.DisplayDate.ToString("dd MMMM yyyy")
                        </div>
                        
                        <h3 class="font-bold text-xl text-gray-800 mb-3 leading-snug group-hover:text-primary transition-colors flex-1">@item.Title</h3>
                        
                        <div class="mt-auto flex items-center text-primary text-sm font-bold opacity-0 group-hover:opacity-100 transform translate-x-[-10px] group-hover:translate-x-0 transition-all">
                            Baca Selengkapnya
                            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Q { get; set; }

    [SupplyParameterFromQuery]
    public string? Category { get; set; }

    private List<NewsItem>? newsList;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        newsList = null;
        var allNews = await NewsService.GetNewsAsync();

        if (!string.IsNullOrWhiteSpace(Category))
        {
            allNews = allNews.Where(n => string.Equals(n.CategoryRaw, Category, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        if (!string.IsNullOrWhiteSpace(Q))
        {
             allNews = allNews.Where(n => n.Title.Contains(Q, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        newsList = allNews;
    }
}
