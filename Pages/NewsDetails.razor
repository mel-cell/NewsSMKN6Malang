@page "/news/{Id}"
@using NewsSMKN6Malang.Data
@inject NewsService NewsService
@inject NavigationManager NavigationManager

@if (newsItem == null)
{
    <div class="flex items-center justify-center h-full">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
    </div>
}
else
{
    <div class="max-w-4xl mx-auto pb-12">
        <!-- Back Button -->
        <button @onclick="GoBack" class="flex items-center gap-2 text-gray-500 hover:text-primary transition-colors mb-6 group">
            <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center group-hover:border-primary group-hover:bg-blue-50 transition-all">
                 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </div>
            <span class="font-semibold text-sm">Kembali</span>
        </button>

        <!-- Article Header -->
        <header class="mb-8">
            <div class="flex items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-full bg-blue-100 text-primary text-xs font-bold uppercase tracking-wide">@newsItem.DisplayCategory</span>
                <span class="text-gray-400 text-xs font-medium flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    @newsItem.DisplayDate.ToString("dd MMMM yyyy")
                </span>
            </div>
            
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-gray-900 leading-tight mb-6">
                @newsItem.Title
            </h1>

            <div class="flex items-center justify-between border-y border-gray-100 py-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-gray-200 overflow-hidden">
                        <img src="https://ui-avatars.com/api/?name=Admin+SMK&background=random" alt="Author" />
                    </div>
                    <div>
                        <p class="text-sm font-bold text-gray-800">Admin Sekolah</p>
                        <p class="text-xs text-gray-500">Tim Jurnalistik</p>
                    </div>
                </div>

            </div>
        </header>

        <!-- Featured Image -->
        <div class="rounded-2xl overflow-hidden shadow-lg mb-10 h-[300px] md:h-[450px]">
            <img src="@newsItem.DisplayImageUrl" class="w-full h-full object-cover" alt="@newsItem.Title" />
        </div>

        <!-- Article Content -->
        <article class="prose prose-lg max-w-none prose-headings:font-heading prose-a:text-primary prose-img:rounded-xl text-gray-600 leading-relaxed">
            <p class="font-medium text-xl text-gray-800 mb-6">@newsItem.Description</p>
            
            @foreach (var paragraph in ExtractTextFromLexical(newsItem.Content))
            {
                <p>@paragraph</p>
            }
        </article>
        
        <!-- Related News Omitted for brevity... -->
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; }

    private NewsItem newsItem;

    protected override async Task OnInitializedAsync()
    {
        if (int.TryParse(Id, out var intId))
        {
            newsItem = await NewsService.GetNewsByIdAsync(intId);
        }
    }
    
    private List<string> ExtractTextFromLexical(object contentObj)
    {
        var paragraphs = new List<string>();
        if (contentObj is System.Text.Json.JsonElement element)
        {
            ExtractTextRecursive(element, paragraphs);
        }
        else
        {
            paragraphs.Add("Konten berita tidak dapat ditampilkan formatnya di saat ini.");
        }
        return paragraphs.Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
    }

    private void ExtractTextRecursive(System.Text.Json.JsonElement element, List<string> output)
    {
        if (element.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            if (element.TryGetProperty("type", out var typeProp) && typeProp.GetString() == "paragraph")
            {
                // extract all text from children
                var pText = string.Empty;
                if (element.TryGetProperty("children", out var children) && children.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    foreach (var child in children.EnumerateArray())
                    {
                        if (child.TryGetProperty("text", out var textProp))
                        {
                            pText += textProp.GetString();
                        }
                    }
                }
                if (!string.IsNullOrEmpty(pText))
                {
                    output.Add(pText);
                }
            }
            else
            {
                foreach (var prop in element.EnumerateObject())
                {
                    ExtractTextRecursive(prop.Value, output);
                }
            }
        }
        else if (element.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            foreach (var child in element.EnumerateArray())
            {
                ExtractTextRecursive(child, output);
            }
        }
    }
    
    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }
}
